#!/bin/sh

# 1. Проверяем, доступны ли нужные утилиты
if ! command -v clang-format >/dev/null 2>&1; then
    echo "❌ Error: clang-format is not installed."
    exit 1
fi

if command -v clang-format-diff >/dev/null 2>&1; then
    DIFF_TOOL="clang-format-diff"
elif command -v clang-format-diff.py >/dev/null 2>&1; then
    DIFF_TOOL="clang-format-diff.py"
else
    echo "❌ Error: clang-format-diff wrapper not found. Please install llvm/clang tools."
    exit 1
fi

# 2. Получаем список изменений и проверяем их через clang-format-diff без флага -i
# Флаг -v заставит утилиту вывести diff, если код не соответствует правилам
STAGED_DIFF=$(git diff --cached --unified=0 | $DIFF_TOOL -p1)

# 3. Если вывод не пустой, значит есть нарушения форматирования
if [ -n "$STAGED_DIFF" ]; then
    echo "❌ Git commit aborted: Code formatting violations found!"
    echo "========================================================="
    echo "$STAGED_DIFF"
    echo "========================================================="
    echo "💡 To fix this, run clang-format on your modified files or lines,"
    echo "   or use: git diff --cached --unified=0 | clang-format-diff -p1 -i"
    
    # Запрещаем коммит
    exit 1
fi

echo "✅ Code formatting check passed successfully!"
exit 0
